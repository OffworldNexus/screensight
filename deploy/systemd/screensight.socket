[Unit]
Description=Screensight control socket
Documentation=https://github.com/offworld-nexus/screensight

[Socket]
# systemd creates this and passes it to screensightd.service as fd 3. The
# explicit Service= matters: without it the socket would look for the default
# `screensight.service` and refuse to start.
Service=screensightd.service
ListenStream=/run/screensight/control.sock
# The socket is a local filesystem socket and is never exposed on the network.
# It is world-accessible so the admin SSH user can run `screensight status`/
# `pair`/`select` without sudo on this single-user kiosk.
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
